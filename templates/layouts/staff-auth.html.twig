<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="{{ asset('assets/js/theme.js') }}"></script>
    <title>{% block title %}Administration — AEESGS{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    {% include 'partials/inter.html.twig' %}
    <link href="{{ asset('assets/css/admin.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/staff-login.css') }}" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="staff-auth{% block body_class %}{% endblock %}">
    {% if flash %}
        <script id="flash-data" type="application/json">{{ flash|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
    {% endif %}

    <header class="staff-auth-header landing-header">
        <div class="staff-auth-container staff-auth-header-inner">
            <div class="staff-auth-brand">
                {% if public_logo_available %}
                    <img src="{{ asset('assets/img/logo.png') }}" alt="" width="40" height="40">
                {% endif %}
                <div>
                    <strong>AEESGS</strong>
                    <span>Espace administration</span>
                </div>
                <p>Association des élèves, étudiants et stagiaires guinéens au Sénégal</p>
            </div>
            <button type="button" class="btn btn-outline-secondary theme-switcher">
                <i class="fa-solid fa-moon staff-auth-moon" aria-hidden="true"></i>
                <i class="fa-solid fa-sun staff-auth-sun" aria-hidden="true"></i>
                <span class="theme-label">Mode sombre</span>
            </button>
            <nav class="staff-auth-nav" aria-label="Navigation principale">
                <a href="{{ public_home_url }}">Accueil AEESGS</a>
            </nav>
            {% block header_action %}{% endblock %}
        </div>
    </header>

    <main class="staff-auth-main staff-auth-container">
        {% block body %}{% endblock %}
    </main>

    {% block footer %}{% endblock %}
    <script src="{{ asset('assets/js/app-alerts.js') }}"></script>
</body>
</html>
