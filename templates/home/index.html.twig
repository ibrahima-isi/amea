{% extends 'layouts/public.html.twig' %}
{% block title %}AEESGS — Guinéens au Sénégal{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('assets/css/journal.css') }}">{% endblock %}
{% block body %}
<section class="community-hero public-container">
    <div class="hero-intro">
        <p class="community-location"><span class="guinea-colors" aria-hidden="true"><i></i><i></i><i></i></span> Guinéens au Sénégal</p>
        <h1>Loin de chez soi.<br>Jamais seuls.</h1>
        <p class="hero-lead">Des rencontres, des repères et de l’entraide pour les élèves, étudiants et stagiaires guinéens au Sénégal.</p>
        <p>Cette plateforme permet aux élèves, étudiants et stagiaires guinéens résidant au Sénégal de s'enregistrer afin de faciliter la communication, l'entraide et la coordination des activités communautaires.</p>
        <a href="register.php" class="public-button">S’enregistrer <span aria-hidden="true">↗</span></a>
        <small class="hero-note">Enregistrez-vous auprès de l’AEESGS.</small>
    </div>
    <div class="community-gallery" role="region" aria-roledescription="carrousel" aria-label="La vie de notre communauté" data-community-carousel>
        {% for image in slider_images %}
        <figure class="community-slide" role="group" aria-roledescription="diapositive" aria-label="{{ loop.index }} sur {{ slider_images|length }}" {% if not loop.first %}hidden{% endif %}>
            <img src="{{ image.image_path }}" alt="{{ image.caption ?: 'La communauté AEESGS' }}" width="960" height="1080" {% if not loop.first %}loading="lazy"{% endif %}>
            <figcaption><span>La vie de notre communauté</span>{% if image.caption %}<p>{{ image.caption }}</p>{% endif %}</figcaption>
        </figure>
        {% else %}
        <div class="community-empty">{% if public_logo_available %}<img src="{{ asset('assets/img/logo.png') }}" alt="" width="960" height="677">{% else %}<strong class="empty-brand">AEESGS</strong>{% endif %}<p>Élèves, étudiants et stagiaires guinéens au Sénégal</p><span>La vie de notre communauté, bientôt en images.</span></div>
        {% endfor %}
        {% if slider_images|length > 1 %}
        <div class="gallery-controls" hidden>
            <button type="button" data-carousel-prev aria-label="Photo précédente">←</button>
            <span data-carousel-count aria-live="off">1 / {{ slider_images|length }}</span>
            <button type="button" data-carousel-next aria-label="Photo suivante">→</button>
            <button type="button" data-carousel-pause aria-pressed="false">Mettre en pause</button>
        </div>
        <p class="carousel-announcement sr-only" aria-live="polite" aria-atomic="true"></p>
        {% endif %}
    </div>
</section>
<section id="association" class="association-section">
    <div class="public-container association-grid"><h2>L’Amicale des élèves, étudiants et stagiaires guinéens au Sénégal.</h2><div><p>L'<strong>AEESGS</strong> est une organisation qui vise à rassembler et à soutenir tous les élèves, étudiants et stagiaires guinéens poursuivant leurs études au Sénégal.</p><p>Notre mission est de faciliter leur intégration, de promouvoir l'excellence académique et de renforcer les liens de solidarité entre les membres de notre communauté.</p></div></div>
</section>
<section class="public-container community-themes">
    <h2>Pourquoi s’enregistrer ?</h2>
    <div class="themes-grid">
        <article><span class="theme-symbol solidarity" aria-hidden="true">↗</span><h3>Rejoindre la communauté</h3><p>Faites partie d'un réseau solide d'élèves, étudiants et stagiaires guinéens au Sénégal pour partager vos expériences.</p></article>
        <article><span class="theme-symbol information" aria-hidden="true">＋</span><h3>Rester informé</h3><p>Recevez des informations importantes concernant les activités, les opportunités et les événements.</p></article>
        <article><span class="theme-symbol support" aria-hidden="true">↔</span><h3>Bénéficier de soutien</h3><p>Accédez à des ressources d'aide et d'orientation pour vos études et votre séjour au Sénégal.</p></article>
    </div>
    <a href="register.php" class="public-button">S’enregistrer maintenant <span aria-hidden="true">↗</span></a>
</section>
{% if journal_posts %}<section class="public-container journal-home"><h2>Le journal de l’AEESGS</h2><div class="journal-grid">{% for post in journal_posts %}{% include 'journal/card.html.twig' with {'post': post} only %}{% endfor %}</div><a href="journal.php">Voir tout le journal →</a></section>{% endif %}
{% endblock %}
{% block javascripts %}<script src="{{ asset('assets/js/community-carousel.js') }}" defer></script>{% endblock %}
