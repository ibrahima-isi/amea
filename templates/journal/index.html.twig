{% extends 'layouts/public.html.twig' %}
{% block title %}Journal — AEESGS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('assets/css/journal.css') }}">{% endblock %}
{% block body %}<section class="public-container journal-public"><p>La vie de notre communauté</p><h1>Le journal de l’AEESGS</h1><nav class="journal-filters" aria-label="Rubriques du journal">{% for key,label in {'all':'Tout','upcoming':'Activités à venir','reports':'Comptes rendus','announcements':'Annonces','archives':'Archives'} %}<a href="journal.php?view={{ key }}" {% if view == key %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav><div class="journal-grid">{% for post in result.items %}{% include 'journal/card.html.twig' with {'post': post, 'now': now} only %}{% else %}<p>Aucune publication dans cette rubrique pour le moment.</p>{% endfor %}</div><nav class="journal-pagination" aria-label="Pagination">{% if page > 1 %}<a href="journal.php?view={{ view }}&amp;page={{ page - 1 }}">← Précédent</a>{% endif %}{% if page * 12 < result.total %}<a href="journal.php?view={{ view }}&amp;page={{ page + 1 }}">Suivant →</a>{% endif %}</nav></section>{% endblock %}
