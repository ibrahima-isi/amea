<article class="journal-card">
    {% if post.cover_path %}{% set cover_v = journal_cover_version(post.cover_path) %}<img class="journal-card-cover" src="journal-cover.php?slug={{ post.slug|url_encode }}{% if cover_v %}&amp;v={{ cover_v|url_encode }}{% endif %}" alt="{{ post.cover_alt }}" loading="lazy">{% endif %}
    {% include 'journal/metadata.html.twig' with {'post': post, 'now': now|default(null)} only %}
    <h2><a href="journal-article.php?slug={{ post.slug|url_encode }}">{{ post.title }}</a></h2>
    <p>{{ post.summary }}</p>
</article>
