<article class="journal-article"><h1>{{ post.title }}</h1>{% include 'journal/metadata.html.twig' with {'post': post, 'now': now|default(null)} only %}{% if post.summary %}<p>{{ post.summary }}</p>{% endif %}{% if cover_url %}<img src="{{ cover_url }}" alt="{{ post.cover_alt }}">{% endif %}{% for paragraph in post.body|default('')|split('\n') %}<p>{{ paragraph }}</p>{% endfor %}</article>
