<article class="journal-article"><h1>{{ post.title }}</h1>{% if post.summary %}<p>{{ post.summary }}</p>{% endif %}{% if cover_url %}<img src="{{ cover_url }}" alt="{{ post.cover_alt }}">{% endif %}{% if post.type == 'ACTIVITY' %}<p>{% if post.activity_start_at %}{{ post.activity_start_at|date('d/m/Y') }}{% if post.activity_start_time_set %} à {{ post.activity_start_at|date('H:i') }}{% endif %}{% endif %}{% if post.activity_end_at %} — {{ post.activity_end_at|date('d/m/Y') }}{% if post.activity_end_time_set %} à {{ post.activity_end_at|date('H:i') }}{% endif %}{% endif %}{% if post.location %} · {{ post.location }}{% endif %}</p>{% endif %}{% for paragraph in post.body|default('')|split('\n') %}<p>{{ paragraph }}</p>{% endfor %}</article>
