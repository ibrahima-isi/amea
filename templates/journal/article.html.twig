<article class="journal-article"><h1>{{ post.title }}</h1>{% if post.summary %}<p>{{ post.summary }}</p>{% endif %}{% if cover_url %}<img src="{{ cover_url }}" alt="{{ post.cover_alt }}">{% endif %}{% if post.type == 'ACTIVITY' %}<p>{{ post.activity_start_at }}{% if post.activity_end_at %} — {{ post.activity_end_at }}{% endif %} · {{ post.location }}</p>{% endif %}{% for paragraph in post.body|split('\n') %}<p>{{ paragraph }}</p>{% endfor %}</article>
