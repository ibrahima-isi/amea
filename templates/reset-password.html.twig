{% extends 'layouts/staff-auth.html.twig' %}

{% block title %}Réinitialiser le mot de passe — AEESGS{% endblock %}

{% block body %}
    <section class="card staff-auth-panel" aria-labelledby="reset-password-heading">
        <h1 id="reset-password-heading" class="staff-auth-title">Réinitialiser le mot de passe</h1>

        <form method="POST" action="reset-password.php" class="staff-auth-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="token" value="{{ token }}">

            <div>
                <label for="password" class="form-label">Nouveau mot de passe</label>
                <input type="password" id="password" name="password" class="form-control" autocomplete="new-password"
                       minlength="8" required aria-describedby="password-requirement">
                <div id="password-requirement" class="form-text">Minimum 8 caractères</div>
            </div>
            <div>
                <label for="confirm_password" class="form-label">Confirmer le mot de passe</label>
                <input type="password" id="confirm_password" name="confirm_password" class="form-control"
                       autocomplete="new-password" minlength="8" required placeholder="Répétez le mot de passe">
            </div>
            <button type="submit" class="btn btn-primary">Réinitialiser</button>
        </form>

        <a href="forgot-password.php" class="staff-auth-return"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour</a>
    </section>
{% endblock %}
