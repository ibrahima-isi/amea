{% extends 'layouts/admin.html.twig' %}

{% block title %}AEESGS — Tableau de bord{% endblock %}

{% block body %}
<!-- Page header -->
<div class="dash-header">
  <div>
    <h1 class="mb-1">Tableau de bord</h1>
    <p class="dash-subtitle">Bienvenue, <strong>{{ user_fullname|e }}</strong> &middot; {{ role_label }}</p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    {% if can_see_students %}
      <a href="students.php" class="btn btn-outline-secondary btn-sm"><i class="fas fa-user-graduate me-1"></i> Adhérents</a>
    {% endif %}
    {% if can_export %}
      <a href="export.php" class="btn btn-primary btn-sm"><i class="fas fa-file-export me-1"></i> Exporter</a>
    {% endif %}
  </div>
</div>

{% if can_review %}
<section class="review-work mb-4" aria-labelledby="review-heading">
  <div class="review-work-heading">
    <div><h2 id="review-heading">Dossiers à traiter <span class="badge bg-primary">{{ review_count }}</span></h2>
    <p class="text-muted mb-0">Les dossiers les plus anciens sont présentés en premier.</p></div>
    <a href="kyc-list.php" class="btn btn-outline-primary">Tous les dossiers</a>
  </div>
  <div class="review-queue">
    {% for student in review_queue %}
    <article class="review-item">
      <div><h3>{{ student.firstName }} {{ student.lastName }}</h3><span class="text-muted">{{ student.status }} · {{ student.registrationDate|date('d/m/Y H:i') }}</span></div>
      <span class="badge bg-info">Sous révision</span>
      <a href="kyc-detail.php?id={{ student.id }}" class="btn btn-primary btn-sm" aria-label="Examiner le dossier de {{ student.firstName }} {{ student.lastName }}">Examiner</a>
    </article>
    {% else %}
    <p class="review-empty">Aucun dossier à examiner pour le moment. Les nouvelles demandes apparaîtront ici.</p>
    {% endfor %}
  </div>
  <p class="review-waiting mb-0"><i class="fas fa-clock me-2" aria-hidden="true"></i>{{ clarification_count }} dossier(s) en attente de réponse de l’adhérent après demande de complément.</p>
</section>
{% endif %}
<h2 class="h5 mb-3">Vue d’ensemble des adhérents</h2>

<!-- Stat cards -->
<div class="row g-3 mb-4">

  <div class="col-xl-3 col-md-6 col-sm-6">
    <a href="students.php" class="stat-card">
      <div class="stat-icon stat-icon-green">
        <i class="fas fa-users"></i>
      </div>
      <div class="stat-body">
        <div class="stat-value">{{ stats.total|number_format(0, ',', " ") }}</div>
        <div class="stat-label">Total inscrits</div>
        <div class="stat-sub"><i class="fas fa-arrow-up fa-xs"></i> {{ recent_week }} cette semaine</div>
      </div>
    </a>
  </div>

  <div class="col-xl-3 col-md-6 col-sm-6">
    <a href="students.php" class="stat-card">
      <div class="stat-icon stat-icon-yellow">
        <i class="fas fa-calendar-plus"></i>
      </div>
      <div class="stat-body">
        <div class="stat-value">{{ recent_month }}</div>
        <div class="stat-label">Nouveaux (30 jours)</div>
        <div class="stat-sub"><i class="fas fa-clock fa-xs"></i> Derniers 30 jours</div>
      </div>
    </a>
  </div>

  <div class="col-xl-3 col-md-6 col-sm-6">
    <a href="students.php" class="stat-card">
      <div class="stat-icon stat-icon-dark">
        <i class="fas fa-venus-mars"></i>
      </div>
      <div class="stat-body">
        <div class="stat-value">{{ stats.men }}&thinsp;/&thinsp;{{ stats.women }}</div>
        <div class="stat-label">Hommes / Femmes</div>
        <div class="stat-sub"><i class="fas fa-mars fa-xs"></i> {{ stats.men }} &nbsp;<i class="fas fa-venus fa-xs"></i> {{ stats.women }}</div>
      </div>
    </a>
  </div>

  <div class="col-xl-3 col-md-6 col-sm-6">
    <a href="students.php" class="stat-card">
      <div class="stat-icon stat-icon-red">
        <i class="fas fa-layer-group"></i>
      </div>
      <div class="stat-body">
        <div class="stat-value">{{ stats.students }}</div>
        <div class="stat-label">Étudiants</div>
        <div class="stat-sub">Él.&thinsp;{{ stats.pupils }} &middot; St.&thinsp;{{ stats.interns }}</div>
      </div>
    </a>
  </div>

</div>

<!-- Charts row 1 -->
<div class="row g-3 mb-3">
  <div class="col-xl-6">
    <div class="card shadow-sm h-100">
      <div class="card-header">
        <span class="chart-card-header">
          <i class="fas fa-chart-pie"></i> Répartition par sexe
        </span>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="genderChart"></canvas>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-6">
    <div class="card shadow-sm h-100">
      <div class="card-header">
        <span class="chart-card-header">
          <i class="fas fa-chart-donut"></i> Répartition par statut
        </span>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="statusChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Charts row 2 -->
<div class="row g-3 mb-4">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-header">
        <span class="chart-card-header">
          <i class="fas fa-building-columns"></i> Top 5 des établissements
        </span>
      </div>
      <div class="card-body">
        <div class="chart-container">
          <canvas id="schoolChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
  (function() {
    var isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
    var brandGreen  = '#526f9a';
    var brandDark   = '#17263C';
    var brandYellow = '#c5a04b';
    var brandRed    = '#ad5960';
    var textColor   = isDark ? '#e9ecef' : '#1a1a1a';
    var gridColor   = isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.05)';
    var borderColor = isDark ? '#1a1d20' : '#fff';

    Chart.defaults.color = textColor;
    Chart.defaults.animation = false;

    var charts = [];
    // Gender — donut
    charts.push(new Chart(document.getElementById('genderChart').getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Masculin', 'Féminin'],
        datasets: [{
          data: [{{ stats.men }}, {{ stats.women }}],
          backgroundColor: [brandGreen, brandYellow],
          hoverBackgroundColor: [brandDark, '#b8940a'],
          borderWidth: 2, borderColor: borderColor
        }]
      },
      options: { maintainAspectRatio: false, responsive: true, plugins: { legend: { position: 'bottom' } } }
    }));

    // Status — donut
    charts.push(new Chart(document.getElementById('statusChart').getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Étudiants', 'Élèves', 'Stagiaires'],
        datasets: [{
          data: [{{ stats.students }}, {{ stats.pupils }}, {{ stats.interns }}],
          backgroundColor: [brandGreen, brandYellow, brandRed],
          hoverBackgroundColor: [brandDark, '#b8940a', '#a00d1f'],
          borderWidth: 2, borderColor: borderColor
        }]
      },
      options: { maintainAspectRatio: false, responsive: true, plugins: { legend: { position: 'bottom' } } }
    }));

    // Schools — bar
    charts.push(new Chart(document.getElementById('schoolChart').getContext('2d'), {
      type: 'bar',
      data: {
        labels: [{{ school_labels|raw }}],
        datasets: [{
          label: "Inscrits",
          data: [{{ school_values|raw }}],
          backgroundColor: brandGreen,
          hoverBackgroundColor: brandDark,
          borderRadius: 6,
          borderSkipped: false
        }]
      },
      options: {
        maintainAspectRatio: false, responsive: true,
        scales: {
          y: {
            beginAtZero: true,
            ticks: { precision: 0, color: textColor },
            grid: { color: gridColor }
          },
          x: {
            ticks: { color: textColor },
            grid: { display: false }
          }
        },
        plugins: { legend: { display: false } }
      }
    }));
    new MutationObserver(function() {
      var dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
      var text = dark ? '#e9ecef' : '#293447';
      Chart.defaults.color = text;
      charts.forEach(function(chart) {
        chart.options.plugins.legend.labels = { color: text };
        chart.data.datasets.forEach(function(dataset) { dataset.borderColor = dark ? '#202b3b' : '#fff'; });
        if (chart.options.scales.y) {
          chart.options.scales.y.ticks.color = text;
          chart.options.scales.x.ticks.color = text;
          chart.options.scales.y.grid.color = dark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.05)';
        }
        chart.update('none');
      });
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
  })();
</script>
{% endblock %}
