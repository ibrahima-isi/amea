{% extends 'layouts/admin.html.twig' %}

{% block title %}AEESGS — Tableau de bord{% endblock %}

{% block body %}
<div class="staff-dashboard">
    <section class="dashboard-welcome" aria-labelledby="welcome-heading">
        <div>
            <h2 id="welcome-heading">Bienvenue{% if user_fullname %}, {{ user_fullname }}{% endif %}</h2>
            <p>{{ role_label }}</p>
        </div>
        {% if staff_navigation.students or staff_navigation.export %}
            <div class="dashboard-actions">
                {% if staff_navigation.students %}
                    <a href="students.php" class="btn btn-outline-secondary"><i class="fas fa-user-graduate me-1" aria-hidden="true"></i> Adhérents</a>
                {% endif %}
                {% if staff_navigation.export %}
                    <a href="export.php" class="btn btn-primary"><i class="fas fa-file-export me-1" aria-hidden="true"></i> Exporter</a>
                {% endif %}
            </div>
        {% endif %}
    </section>

    {% set men = stats.men ?? 0 %}
    {% set women = stats.women ?? 0 %}
    {% set students = stats.students ?? 0 %}
    {% set pupils = stats.pupils ?? 0 %}
    {% set interns = stats.interns ?? 0 %}
    {% set graduates = stats.graduates ?? 0 %}
    {% set metrics = [
        {label: 'Total inscrits', value: stats.total|number_format(0, ',', ' '), detail: recent_week ~ ' cette semaine', icon: 'fa-users', color: 'orange'},
        {label: 'Nouveaux (30 jours)', value: recent_month, icon: 'fa-clock', color: 'green'},
        {label: 'Hommes / Femmes', value: men ~ ' / ' ~ women, icon: 'fa-venus-mars', color: 'blue'},
        {label: 'Étudiants', value: students, detail: pupils ~ ' élèves · ' ~ interns ~ ' stagiaires', icon: 'fa-graduation-cap', color: 'red'}
    ] %}
    <section class="dashboard-metrics" aria-label="Indicateurs d’adhésion">
        {% for metric in metrics %}
            <article class="dashboard-card dashboard-metric">
                <div class="dashboard-metric-heading">
                    <h2>{{ metric.label }}</h2>
                    <span class="dashboard-metric-icon dashboard-color-{{ metric.color }}"><i class="fas {{ metric.icon }}" aria-hidden="true"></i></span>
                </div>
                <strong>{{ metric.value }}</strong>
                {% if metric.detail is defined %}<p>{{ metric.detail }}</p>{% endif %}
            </article>
        {% endfor %}
    </section>

    <div class="dashboard-charts">
        <section class="dashboard-card dashboard-chart" aria-labelledby="school-heading">
            <h2 id="school-heading">Top 5 des établissements</h2>
            {% if school_values is not empty %}
                <div class="dashboard-plot" hidden>
                    <canvas aria-hidden="true" data-dashboard-chart="schools"
                        data-labels="{{ school_labels|json_encode }}" data-values="{{ school_values|json_encode }}"></canvas>
                </div>
                <details class="dashboard-school-details">
                    <summary>Données par établissement</summary>
                    <ul>
                        {% for label in school_labels %}
                            <li>{{ label }} · {{ school_values[loop.index0] }}</li>
                        {% endfor %}
                    </ul>
                </details>
            {% else %}
                <p class="dashboard-empty">Aucun établissement à afficher.</p>
            {% endif %}
        </section>

        <section class="dashboard-card dashboard-chart" aria-labelledby="status-heading">
            <h2 id="status-heading">Répartition par statut</h2>
            {% set status_labels = ['Étudiants', 'Élèves', 'Stagiaires', 'Diplômés'] %}
            {% set status_values = [students, pupils, interns, graduates] %}
            {% set status_colors = ['green', 'orange', 'red', 'blue'] %}
            {% set status_total = students + pupils + interns + graduates %}
            {% if status_total > 0 %}
                <div class="dashboard-plot dashboard-pie" hidden>
                    <canvas aria-hidden="true" data-dashboard-chart="status"
                        data-labels="{{ status_labels|json_encode }}" data-values="{{ status_values|json_encode }}"
                        data-colors="{{ status_colors|json_encode }}"></canvas>
                </div>
                <ul class="dashboard-legend">
                    {% for label in status_labels %}
                        {% set count = status_values[loop.index0] %}
                        <li><span class="dashboard-dot dashboard-color-{{ status_colors[loop.index0] }}" aria-hidden="true"></span>{{ label }} <strong>{{ (100 * count / status_total)|number_format(0, ',', ' ') }} %</strong><span class="visually-hidden"> ({{ count }})</span></li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="dashboard-empty">Aucun statut à afficher.</p>
            {% endif %}
        </section>
    </div>

    {% if can_review %}
        <section class="dashboard-card dashboard-queue" aria-labelledby="review-heading">
            <header>
                <h2 id="review-heading">Dossiers à traiter <span class="dashboard-badge">{{ review_count }}</span></h2>
                <a href="kyc-list.php" class="btn btn-outline-primary btn-sm">Tous les dossiers</a>
            </header>
            <p>Les dossiers les plus anciens sont présentés en premier.</p>
            {% if review_queue is not empty %}
                <ul class="dashboard-review-list">
                    {% for student in review_queue %}
                        <li>
                            <div class="dashboard-review-person">
                                <h3><span class="dashboard-dot dashboard-color-orange" aria-hidden="true"></span>{{ student.firstName }} {{ student.lastName }}</h3>
                                <span>{{ student.status }} · {{ student.registrationDate|date('d/m/Y H:i') }}</span>
                            </div>
                            <span class="dashboard-badge">Sous révision</span>
                            <a href="kyc-detail.php?id={{ student.id }}" class="btn btn-primary btn-sm" aria-label="Examiner le dossier de {{ student.firstName }} {{ student.lastName }}">Examiner</a>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="dashboard-empty">Aucun dossier à examiner pour le moment. Les nouvelles demandes apparaîtront ici.</p>
            {% endif %}
            <p class="dashboard-review-waiting"><i class="fas fa-clock me-2" aria-hidden="true"></i>{{ clarification_count }} dossier(s) en attente de réponse de l’adhérent après demande de complément.</p>
        </section>
    {% endif %}

    <section class="dashboard-card dashboard-chart" aria-labelledby="gender-heading">
        <h2 id="gender-heading">Répartition par sexe</h2>
        {% if men + women > 0 %}
            <div class="dashboard-plot dashboard-gender" hidden>
                <canvas aria-hidden="true" data-dashboard-chart="gender"
                    data-labels="{{ ['Masculin', 'Féminin']|json_encode }}" data-values="{{ [men, women]|json_encode }}"
                    data-colors="{{ ['blue', 'orange']|json_encode }}"></canvas>
            </div>
            <ul class="dashboard-legend">
                <li><span class="dashboard-dot dashboard-color-blue" aria-hidden="true"></span>Masculin <strong>{{ men }}</strong></li>
                <li><span class="dashboard-dot dashboard-color-orange" aria-hidden="true"></span>Féminin <strong>{{ women }}</strong></li>
            </ul>
        {% else %}
            <p class="dashboard-empty">Aucune répartition à afficher.</p>
        {% endif %}
    </section>
</div>
{% endblock %}

{% block javascripts %}
    <script defer src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script defer src="{{ asset('assets/js/staff-dashboard.js') }}"></script>
{% endblock %}
