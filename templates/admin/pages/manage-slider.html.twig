{% extends 'layouts/admin.html.twig' %}

{% block title %}Gérer le carrousel — AEESGS{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Gérer le carrousel</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="dashboard.php">Tableau de bord</a></li>
                <li class="breadcrumb-item active">Carrousel</li>
            </ol>
        </nav>
    </div>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addImageModal">
        <i class="fas fa-plus me-1"></i> Ajouter une image
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Aperçu</th>
                        <th>Légende</th>
                        <th>Ordre</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for img in images %}
                    <tr>
                        <td>
                            <img src="{{ img.image_path }}" alt="Slide" class="img-thumbnail" style="max-height: 60px; max-width: 120px; object-fit: cover;">
                        </td>
                        <td>{{ img.caption ?: '—' }}</td>
                        <td>{{ img.display_order }}</td>
                        <td class="text-end">
                            <form method="POST" action="manage-slider.php" class="d-inline" onsubmit="return confirm('Supprimer cette image ?');">
                                <input type="hidden" name="csrf_token"  value="{{ csrf_token }}">
                                <input type="hidden" name="_action"     value="delete">
                                <input type="hidden" name="id"          value="{{ img.id }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="4" class="text-center text-muted py-4">Aucune image dans le carrousel.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# ─── Add image modal ────────────────────────────────────────────────────── #}
<div class="modal fade" id="addImageModal" tabindex="-1" aria-labelledby="addImageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addImageModalLabel">Ajouter une image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" action="manage-slider.php" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="csrf_token"  value="{{ csrf_token }}">
                    <input type="hidden" name="_action"     value="store">

                    <div class="mb-3">
                        <label for="slider_image" class="form-label">Fichier image <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="slider_image" name="slider_image" accept="image/*" required>
                        <div class="form-text">Formats acceptés : JPG, JPEG, PNG, GIF, WEBP — max 5 Mo.</div>
                    </div>

                    <div class="mb-3">
                        <label for="caption" class="form-label">Légende (optionnel)</label>
                        <textarea class="form-control" id="caption" name="caption" rows="2" placeholder="Une courte description…"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="display_order" class="form-label">Ordre d'affichage</label>
                        <input type="number" class="form-control" id="display_order" name="display_order" value="0" min="0">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-upload me-1"></i> Ajouter</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
