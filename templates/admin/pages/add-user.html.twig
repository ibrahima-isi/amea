{% extends 'layouts/admin.html.twig' %}

{% block title %}AEESGS - Ajouter un utilisateur{% endblock %}

{% block body %}
<div class="page-header">
  <div>
    <h1>Ajouter un utilisateur</h1>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="dashboard.php">Tableau de bord</a></li>
      <li class="breadcrumb-item"><a href="users.php">Utilisateurs</a></li>
      <li class="breadcrumb-item active" aria-current="page">Ajouter</li>
    </ol></nav>
  </div>
</div>

{% if errors is not empty %}
<div class="alert alert-danger">Veuillez corriger les erreurs ci-dessous.</div>
{% endif %}

<div class="row">
  <div class="col-md-8 mx-auto">
    <div class="card shadow">
      <div class="card-header">
        <span class="chart-card-header"><i class="fas fa-user-plus"></i> Informations de l'utilisateur</span>
      </div>
      <div class="card-body">
        <form method="POST" action="add-user.php" novalidate>
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <div class="row g-3">
            <div class="col-md-6">
              <label for="username" class="form-label">Nom d'utilisateur</label>
              <input type="text"
                     class="form-control {{ errors.username is defined ? 'is-invalid' : '' }}"
                     id="username" name="username"
                     value="{{ formData.username ?? '' }}" required>
              {% if errors.username is defined %}
                <div class="text-danger">{{ errors.username }}</div>
              {% endif %}
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label">Email</label>
              <input type="email"
                     class="form-control {{ errors.email is defined ? 'is-invalid' : '' }}"
                     id="email" name="email"
                     value="{{ formData.email ?? '' }}"
                     placeholder="nom.prenom@exemple.com" required>
              {% if errors.email is defined %}
                <div class="text-danger">{{ errors.email }}</div>
              {% endif %}
            </div>
            <div class="col-md-6">
              <label for="last_name" class="form-label">Nom</label>
              <input type="text"
                     class="form-control {{ errors.last_name is defined ? 'is-invalid' : '' }}"
                     id="last_name" name="last_name"
                     value="{{ formData.last_name ?? '' }}" required>
              {% if errors.last_name is defined %}
                <div class="text-danger">{{ errors.last_name }}</div>
              {% endif %}
            </div>
            <div class="col-md-6">
              <label for="first_name" class="form-label">Prénom</label>
              <input type="text"
                     class="form-control {{ errors.first_name is defined ? 'is-invalid' : '' }}"
                     id="first_name" name="first_name"
                     value="{{ formData.first_name ?? '' }}" required>
              {% if errors.first_name is defined %}
                <div class="text-danger">{{ errors.first_name }}</div>
              {% endif %}
            </div>
            <div class="col-md-6">
              <label for="password" class="form-label">Mot de passe</label>
              <input type="password"
                     class="form-control {{ errors.password is defined ? 'is-invalid' : '' }}"
                     id="password" name="password" required>
              {% if errors.password is defined %}
                <div class="text-danger">{{ errors.password }}</div>
              {% endif %}
            </div>
            <div class="col-md-6">
              <label for="confirm_password" class="form-label">Confirmer le mot de passe</label>
              <input type="password"
                     class="form-control {{ errors.confirm_password is defined ? 'is-invalid' : '' }}"
                     id="confirm_password" name="confirm_password" required>
              {% if errors.confirm_password is defined %}
                <div class="text-danger">{{ errors.confirm_password }}</div>
              {% endif %}
            </div>
            <div class="col-md-6">
              <label for="role" class="form-label">Rôle</label>
              <select class="form-select" id="role" name="role" required>
                <option value="user" {{ (formData.role ?? 'user') == 'user' ? 'selected' : '' }}>Utilisateur</option>
                <option value="admin" {{ (formData.role ?? 'user') == 'admin' ? 'selected' : '' }}>Administrateur</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="is_active" class="form-label">Statut</label>
              <select class="form-select" id="is_active" name="is_active" required>
                <option value="1" {{ (formData.is_active ?? 1) == 1 ? 'selected' : '' }}>Actif</option>
                <option value="0" {{ (formData.is_active ?? 1) == 0 ? 'selected' : '' }}>Inactif</option>
              </select>
            </div>
          </div>

          <div id="permissionsSection" class="mt-4 border-top pt-3"
               style="display: {{ (formData.role ?? 'user') == 'admin' ? 'block' : 'none' }};">
            <h5 class="h6 mb-3"><i class="fas fa-lock me-2"></i>Permissions d'accès aux modules</h5>
            <div class="row g-2">
              {% set permLabels = {
                'students': 'Étudiants',
                'export': 'Export',
                'users': 'Utilisateurs',
                'slider': 'Carrousel',
                'upgrade': 'Mise à niveau',
                'documents': 'Documents',
                'communications': 'Communications',
                'settings': 'Paramètres'
              } %}
              {% for mod in modules %}
              <div class="col-md-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox"
                         name="permissions[]" value="{{ mod }}"
                         id="perm_{{ mod }}"
                         {{ (formData.permissions is defined and mod in formData.permissions) ? 'checked' : '' }}>
                  <label class="form-check-label" for="perm_{{ mod }}">
                    {{ permLabels[mod] ?? mod }}
                  </label>
                </div>
              </div>
              {% endfor %}
            </div>
            <small class="text-muted d-block mt-2">
              <i class="fas fa-info-circle me-1"></i>L'utilisateur avec l'ID 1 est le Super Admin et possède toutes les permissions par défaut.
            </small>
          </div>

          <div class="mt-3 text-end">
            <a href="users.php" class="btn btn-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.getElementById('role').addEventListener('change', function () {
  document.getElementById('permissionsSection').style.display =
    this.value === 'admin' ? 'block' : 'none';
});
</script>
{% endblock %}
