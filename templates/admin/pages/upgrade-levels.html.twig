{% extends 'layouts/admin.html.twig' %}

{% block title %}Mise à niveau des membres — AEESGS{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Mise à niveau des membres</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="dashboard.php">Tableau de bord</a></li>
                <li class="breadcrumb-item active">Mise à niveau</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <i class="fas fa-level-up-alt me-1"></i> Membres — changement de statut
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Établissement</th>
                        <th>Statut actuel</th>
                        <th>Nouveau statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in students %}
                    <tr>
                        <td class="fw-bold">{{ s.lastName }}</td>
                        <td>{{ s.firstName }}</td>
                        <td>{{ s.institution ?: '—' }}</td>
                        <td><span class="badge bg-secondary">{{ s.status }}</span></td>
                        <td>
                            <form method="POST" action="confirm-upgrade.php" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="csrf_token"  value="{{ csrf_token }}">
                                <input type="hidden" name="student_id"  value="{{ s.id }}">
                                <select name="new_status" class="form-select form-select-sm" style="width: auto;">
                                    <option value="ELEVE"     {% if s.status == 'ELEVE'     %}selected{% endif %}>Élève</option>
                                    <option value="ETUDIANT"  {% if s.status == 'ETUDIANT'  %}selected{% endif %}>Étudiant</option>
                                    <option value="STAGIAIRE" {% if s.status == 'STAGIAIRE' %}selected{% endif %}>Stagiaire</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary" title="Appliquer">
                                    <i class="fas fa-check"></i>
                                </button>
                            </form>
                        </td>
                        <td>
                            <a href="student-details.php?id={{ s.id }}" class="btn btn-sm btn-outline-secondary" title="Voir le profil">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-4">Aucun membre trouvé.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
