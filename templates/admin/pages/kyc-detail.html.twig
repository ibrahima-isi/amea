{% extends 'layouts/admin.html.twig' %}

{% block title %}Examen Dossier - {{ student.firstName }} {{ student.lastName }}{% endblock %}

{% block body %}
<div class="container-fluid py-4 dossier-review">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="kyc-list.php">Liste KYC</a></li>
            <li class="breadcrumb-item active">Examen Dossier</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Main Data -->
        <div class="col-lg-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Informations de l’adhérent</h5>
                    <span class="badge bg-info">SOUS RÉVISION</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 detail-group">
                            <div class="detail-label">Prénom & Nom</div>
                            <div class="detail-value">{{ student.firstName }} {{ student.lastName }}</div>
                        </div>
                        <div class="col-md-6 detail-group">
                            <div class="detail-label">Sexe</div>
                            <div class="detail-value">{{ student.gender }}</div>
                        </div>
                        <div class="col-md-6 detail-group">
                            <div class="detail-label">Email</div>
                            <div class="detail-value">{{ student.email }}</div>
                        </div>
                        <div class="col-md-6 detail-group">
                            <div class="detail-label">Téléphone</div>
                            <div class="detail-value">{{ student.phone }}</div>
                        </div>
                        <div class="col-md-6 detail-group">
                            <div class="detail-label">Date de naissance</div>
                            <div class="detail-value">
                                {% if student.birthDate %}
                                    {{ student.birthDate }} ({{ student.age }} ans)
                                {% else %}
                                    Non renseignée
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <hr>

                    <h6 class="text-primary mb-3">Parcours Académique</h6>
                    <div class="row">
                        <div class="col-md-6 detail-group">
                            <div class="detail-label">Établissement</div>
                            <div class="detail-value">{{ student.institution }}</div>
                        </div>
                        <div class="col-md-6 detail-group">
                            <div class="detail-label">Statut</div>
                            <div class="detail-value">{{ student.status }}</div>
                        </div>
                        <div class="col-md-6 detail-group">
                            <div class="detail-label">Niveau d'études</div>
                            <div class="detail-value">{{ student.studyLevel }}</div>
                        </div>
                        <div class="col-md-6 detail-group">
                            <div class="detail-label">Domaine d'études</div>
                            <div class="detail-value">{{ student.studyField }}</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <section class="col-lg-6 mb-4" aria-labelledby="documents-heading">
            <div class="card shadow-sm h-100">
                <div class="card-header"><h2 class="h5 mb-0" id="documents-heading">Documents justificatifs</h2></div>
                <div class="card-body">
                {% for document in [{label: 'Pièce d’identité', path: student.identityDocument, type: 'identite'}, {label: 'Curriculum Vitae (CV)', path: student.cvPath, type: 'cv'}] %}
                  <div class="dossier-document mb-4">
                    <h3 class="h6">{{ document.label }}</h3>
                    {% if document.path %}
                      {% set extension = document.path|split('.')|last|lower %}
                      {% if extension == 'pdf' %}
                        <iframe class="dossier-pdf" title="{{ document.label }} de {{ student.firstName }} {{ student.lastName }}" src="download.php?id={{ student.id }}&type={{ document.type }}&inline=1"></iframe>
                      {% elseif extension in ['jpg', 'jpeg', 'png', 'gif'] %}
                        <a href="download.php?id={{ student.id }}&type={{ document.type }}&inline=1" target="_blank" rel="noopener"><img src="download.php?id={{ student.id }}&type={{ document.type }}&inline=1" class="kyc-doc-preview" alt="{{ document.label }} de {{ student.firstName }} {{ student.lastName }}"></a>
                      {% endif %}
                      <div class="d-flex gap-2 flex-wrap mt-2">
                        <a href="download.php?id={{ student.id }}&type={{ document.type }}&inline=1" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Ouvrir {{ document.label }}</a>
                        <a href="download.php?id={{ student.id }}&type={{ document.type }}" class="btn btn-sm btn-outline-secondary">Télécharger</a>
                      </div>
                    {% else %}<p class="text-muted">Document non fourni.</p>{% endif %}
                  </div>
                {% endfor %}
                </div>
            </div>
        </section>

        <!-- Decisions Sidebar -->
        <div class="col-12">
            <div class="card shadow-sm border-primary mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Prendre une décision</h5>
                </div>
                <div class="card-body">
                    <form action="kyc-detail.php?id={{ student.id }}" method="POST">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        
                        <div class="mb-3">
                            <label for="kyc_notes" class="form-label fw-bold">Notes / Commentaire</label>
                            <textarea class="form-control" id="kyc_notes" name="kyc_notes" rows="4" 
                                      placeholder="Ex: 'Photo d'identité floue', 'Veuillez préciser votre établissement'..."></textarea>
                            <div class="form-text">Obligatoire pour les clarifications ou rejets.</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" name="action" value="approve" class="btn btn-success btn-lg">
                                <i class="fas fa-check-circle"></i> Approuver
                            </button>
                            <button type="submit" name="action" value="clarify" class="btn btn-warning">
                                <i class="fas fa-question-circle"></i> Demander Clarification
                            </button>
                            <button type="submit" name="action" value="reject" class="btn btn-danger">
                                <i class="fas fa-times-circle"></i> Rejeter le dossier
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header kyc-history-header">
                    <h6 class="mb-0">Historique KYC</h6>
                </div>
                <div class="card-body">
                    <div class="status-timeline">
                        <div class="mb-3">
                            <div class="fw-bold small">Dernière mise à jour</div>
                            <div class="text-muted small">{{ student.kycUpdatedAt ? student.kycUpdatedAt|date('d/m/Y H:i') : 'N/A' }}</div>
                        </div>
                        <div>
                            <div class="fw-bold small">Token de révision actif</div>
                            <div class="text-muted text-break small font-monospace">{{ student.reviewToken ?: 'Aucun' }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
