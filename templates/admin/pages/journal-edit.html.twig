{% extends 'layouts/admin.html.twig' %}
{% block title %}Modifier le journal — AEESGS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('assets/css/journal.css') }}">{% endblock %}
{% block body %}
<div class="journal"><h1>{{ post.id|default(null) ? 'Modifier la publication' : 'Nouvelle publication' }}</h1><a href="manage-journal.php">Retour au journal</a>
{% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
<form method="post" enctype="multipart/form-data" class="mt-3"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ post.id|default('') }}">{% if post.id|default(null) %}<input type="hidden" name="revision" value="{{ post.revision }}">{% endif %}
<label class="form-label" for="type">Type</label><select class="form-select mb-3" id="type" name="type" required>{% for value,label in {'ACTIVITY':'Activité','REPORT':'Compte rendu','ANNOUNCEMENT':'Annonce'} %}<option value="{{ value }}" {{ post.type|default('ACTIVITY') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select>
{% for key,label in {'title':'Titre','summary':'Résumé','body':'Texte','cover_alt':'Description de l’image','location':'Lieu'} %}<label class="form-label" for="{{ key }}">{{ label }}</label>{% if key in ['body','summary'] %}<textarea class="form-control mb-3" id="{{ key }}" name="{{ key }}" rows="{{ key == 'body' ? 10 : 3 }}">{{ attribute(post|default({}), key)|default('') }}</textarea>{% else %}<input class="form-control mb-3" id="{{ key }}" name="{{ key }}" value="{{ attribute(post|default({}), key)|default('') }}" {{ key == 'title' ? 'required' }}>{% endif %}{% endfor %}
{% for part,label in {'start':'Début','end':'Fin'} %}{% set datetime = attribute(post|default({}), 'activity_' ~ part ~ '_at')|default('') %}<label class="form-label" for="{{ part }}_date">{{ label }} : date</label><input class="form-control mb-3" type="date" id="{{ part }}_date" name="activity_{{ part }}_date" value="{{ attribute(post|default({}), 'activity_' ~ part ~ '_date')|default(datetime|slice(0,10)) }}"><label class="form-label" for="{{ part }}_time">{{ label }} : heure facultative</label><input class="form-control mb-3" type="time" id="{{ part }}_time" name="activity_{{ part }}_time" value="{{ attribute(post|default({}), 'activity_' ~ part ~ '_time')|default(attribute(post|default({}), 'activity_' ~ part ~ '_time_set')|default(false) ? datetime|slice(11,5) : '') }}">{% endfor %}
<label class="form-label" for="cover">Couverture (JPEG, PNG ou WebP, 5 Mio maximum)</label><input class="form-control mb-3" type="file" id="cover" name="cover" accept="image/jpeg,image/png,image/webp">{% if post.cover_path|default(null) %}<label><input type="checkbox" name="remove_cover" value="1"> Retirer la couverture</label><br><a href="journal-preview-cover.php?id={{ post.id }}">Voir la couverture</a>{% endif %}
<div class="d-flex flex-wrap gap-2 mt-3"><button class="btn btn-primary" name="_action" value="save">Enregistrer</button><button class="btn btn-success" name="_action" value="publish">Publier</button>{% if post.status|default('') == 'PUBLISHED' %}<button class="btn btn-outline-danger" name="_action" value="withdraw">Retirer de la publication</button>{% endif %}{% if post.id|default(null) %}<a class="btn btn-outline-secondary" href="journal-preview.php?id={{ post.id }}">Aperçu</a>{% endif %}</div></form></div>
{% endblock %}
