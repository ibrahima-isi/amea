{% extends 'layouts/admin.html.twig' %}

{% block title %}AEESGS - Profil Administrateur{% endblock %}

{% block body %}
<div class="page-header">
  <div>
    <h1>Profil Administrateur</h1>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="dashboard.php">Tableau de bord</a></li>
      <li class="breadcrumb-item active" aria-current="page">Profil</li>
    </ol></nav>
  </div>
</div>

<div class="row">
  {# ─── Left column: account card ─── #}
  <div class="col-md-4 mb-4">
    <div class="card shadow">
      <div class="card-header">
        <span class="chart-card-header"><i class="fas fa-id-card"></i> Informations du compte</span>
      </div>
      <div class="card-body">
        <div class="text-center mb-4">
          <div class="avatar-placeholder rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center avatar-lg">
            {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
          </div>
          <h4 class="fw-bold">{{ user.firstName }} {{ user.lastName }}</h4>
          <p class="mb-1 text-muted">Utilisateur: <strong>{{ user.username }}</strong></p>
          <span class="badge bg-primary">Rôle: {{ user.role }}</span>
        </div>
        <hr>
        <p class="mb-2"><i class="fas fa-envelope me-2"></i> {{ user.email }}</p>
      </div>
    </div>
  </div>

  {# ─── Right column: forms ─── #}
  <div class="col-md-8 mb-4">

    {# Update profile form #}
    <div class="card shadow mb-4">
      <div class="card-header">
        <span class="chart-card-header"><i class="fas fa-user-pen"></i> Mettre à jour le profil</span>
      </div>
      <div class="card-body">
        <form method="POST" action="profile.php">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="action" value="update_profile">
          <div class="row g-3">
            <div class="col-md-6">
              <label for="last_name" class="form-label">Nom</label>
              <input type="text" class="form-control" id="last_name" name="last_name"
                     value="{{ user.lastName }}" required>
            </div>
            <div class="col-md-6">
              <label for="first_name" class="form-label">Prénom</label>
              <input type="text" class="form-control" id="first_name" name="first_name"
                     value="{{ user.firstName }}" required>
            </div>
            <div class="col-md-12">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" name="email"
                     value="{{ user.email }}" placeholder="nom.prenom@exemple.com" required>
            </div>
          </div>
          <div class="mt-3 text-end">
            <a href="dashboard.php" class="btn btn-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
          </div>
        </form>
      </div>
    </div>

    {# Change password form #}
    <div class="card shadow">
      <div class="card-header">
        <span class="chart-card-header"><i class="fas fa-lock"></i> Changer le mot de passe</span>
      </div>
      <div class="card-body">
        <form method="POST" action="profile.php" id="passwordForm">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="action" value="change_password">
          <div class="mb-3">
            <label for="current_password" class="form-label">Mot de passe actuel</label>
            <input type="password" class="form-control" id="current_password" name="current_password" required>
          </div>
          <div class="mb-3">
            <label for="new_password" class="form-label">Nouveau mot de passe</label>
            <input type="password" class="form-control" id="new_password" name="new_password" required>
            <div class="form-text text-muted">Le mot de passe doit contenir au moins 8 caractères.</div>
          </div>
          <div class="mb-3">
            <label for="confirm_password" class="form-label">Confirmer le nouveau mot de passe</label>
            <input type="password" class="form-control" id="confirm_password" name="confirm_password" required>
          </div>
          <button type="submit" class="btn btn-primary"><i class="fas fa-key"></i> Changer le mot de passe</button>
        </form>
      </div>
    </div>

  </div>{# end right col #}
</div>
{% endblock %}

{% block javascripts %}
<script>
document.getElementById('passwordForm')?.addEventListener('submit', function (e) {
  var newPw  = document.getElementById('new_password').value;
  var confPw = document.getElementById('confirm_password').value;
  if (newPw !== confPw) {
    e.preventDefault();
    alert('Les mots de passe ne correspondent pas.');
    return;
  }
  if (newPw.length < 8) {
    e.preventDefault();
    alert('Le mot de passe doit contenir au moins 8 caractères.');
  }
});
</script>
{% endblock %}
