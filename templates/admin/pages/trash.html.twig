{% extends 'layouts/admin.html.twig' %}

{% block title %}AEESGS — Corbeille{% endblock %}

{% block body %}
<div class="page-header">
  <div>
    <h1>Corbeille</h1>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="dashboard.php">Tableau de bord</a></li>
      <li class="breadcrumb-item"><a href="students.php">Étudiants</a></li>
      <li class="breadcrumb-item active" aria-current="page">Corbeille</li>
    </ol></nav>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a href="students.php" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i> Retour aux étudiants</a>
  </div>
</div>

<div class="alert alert-info d-flex align-items-center" role="alert">
  <i class="fas fa-circle-info me-2"></i>
  <div>Les étudiants supprimés sont conservés ici <strong>{{ retentionDays }} jours</strong>, puis définitivement supprimés automatiquement. Vous pouvez les restaurer ou les supprimer immédiatement.</div>
</div>

<div class="card shadow mb-4">
  <div class="card-header">
    <span class="chart-card-header"><i class="fas fa-trash-can"></i> Étudiants archivés ({{ total }})</span>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Nom / Prénom</th>
            <th>Email</th>
            <th>Supprimé le</th>
            <th>Suppression définitive</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for item in items %}
          {% set student = item.student %}
          <tr class="align-middle">
            <td>
              <div class="d-flex align-items-center">
                <img src="{{ student.identityDocument ? asset(student.identityDocument) : asset('assets/img/placeholder.png') }}"
                     class="rounded-circle me-2" width="40" height="40" style="object-fit: cover;"
                     alt="Photo">
                <div>
                  <div class="fw-bold">{{ student.firstName }} {{ student.lastName }}</div>
                  <small class="text-muted">{{ student.institution ?: '—' }}</small>
                </div>
              </div>
            </td>
            <td>{{ student.email ?: '—' }}</td>
            <td class="text-nowrap">
              {{ student.deletedAt ? student.deletedAt|date('d/m/Y H:i') : '—' }}
            </td>
            <td class="text-nowrap">
              {% if item.days_remaining <= 0 %}
                <span class="badge bg-danger">imminente</span>
              {% elseif item.days_remaining <= 7 %}
                <span class="badge bg-warning text-dark">dans {{ item.days_remaining }} j</span>
              {% else %}
                <span class="badge bg-secondary">dans {{ item.days_remaining }} j</span>
              {% endif %}
            </td>
            <td class="text-nowrap">
              <form method="POST" action="trash.php" class="d-inline">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="restore">
                <input type="hidden" name="id" value="{{ student.id }}">
                <button type="submit" class="btn btn-sm btn-outline-success" title="Restaurer">
                  <i class="fas fa-rotate-left"></i> Restaurer
                </button>
              </form>
              <form method="POST" action="trash.php" class="d-inline">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="force_delete">
                <input type="hidden" name="id" value="{{ student.id }}">
                <button type="submit" class="btn btn-sm btn-outline-danger ms-1 btn-force-delete" title="Supprimer définitivement">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="5" class="text-center py-4 text-muted">La corbeille est vide</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if totalPages > 1 %}
    <nav aria-label="Page navigation" class="mt-3">
      <ul class="pagination justify-content-center">
        <li class="page-item {{ page <= 1 ? 'disabled' }}">
          <a class="page-link" href="?page={{ page - 1 }}">Précédent</a>
        </li>
        {% for i in 1..totalPages %}
          {% if i == 1 or i == totalPages or (i >= page - 2 and i <= page + 2) %}
            <li class="page-item {{ i == page ? 'active' }}">
              <a class="page-link" href="?page={{ i }}">{{ i }}</a>
            </li>
          {% elseif i == page - 3 or i == page + 3 %}
            <li class="page-item disabled"><a class="page-link">…</a></li>
          {% endif %}
        {% endfor %}
        <li class="page-item {{ page >= totalPages ? 'disabled' }}">
          <a class="page-link" href="?page={{ page + 1 }}">Suivant</a>
        </li>
      </ul>
    </nav>
    {% endif %}
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.btn-force-delete').forEach(button => {
    button.addEventListener('click', function (e) {
      e.preventDefault();
      const frm = this.closest('form');
      Swal.fire({
        title: 'Suppression définitive ?',
        text: 'Cette action est irréversible. Le dossier et ses fichiers seront supprimés pour toujours.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#CE1126',
        cancelButtonColor: '#009460',
        confirmButtonText: 'Oui, supprimer définitivement',
        cancelButtonText: 'Annuler'
      }).then(result => {
        if (result.isConfirmed) frm.submit();
      });
    });
  });
});
</script>
{% endblock %}
