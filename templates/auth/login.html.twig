{% extends 'layouts/staff-auth.html.twig' %}

{% block title %}Connexion Administration · AEESGS{% endblock %}
{% block body_class %} staff-login{% endblock %}

{% block header_action %}
    <a href="#username" class="btn btn-outline-secondary landing-header-login">Se connecter</a>
{% endblock %}

{% block body %}
    <div class="staff-auth-intro">
        <h1>Espace de gestion de notre communauté</h1>
        <p>Administration, adhésions, activités et communication des élèves, étudiants et stagiaires guinéens au Sénégal.</p>
        <a href="{{ public_home_url }}">Découvrir l’association <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </div>

    <section class="card staff-auth-panel" aria-labelledby="login-heading">
        <h2 id="login-heading" class="staff-auth-title">Se connecter à votre espace</h2>
        <form method="POST" action="login.php" class="staff-auth-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div>
                <label for="username" class="form-label">Nom d’utilisateur</label>
                <input type="text" id="username" name="username" class="form-control" autocomplete="username" required>
            </div>
            <div>
                <label for="password" class="form-label">Mot de passe</label>
                <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
            </div>

            <a href="forgot-password.php" class="staff-auth-forgot">Mot de passe oublié ?</a>
            <button type="submit" class="btn btn-primary">Se connecter</button>
        </form>
    </section>
{% endblock %}

{% block footer %}
    <footer class="staff-auth-footer landing-links" aria-label="Liens utiles">
        <div class="staff-auth-container">
            <a href="{{ public_register_url }}"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> S’enregistrer comme adhérent</a>
            <a href="{{ public_home_url }}"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour à l’accueil</a>
        </div>
    </footer>
{% endblock %}
