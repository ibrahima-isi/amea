{% set staff_page_labels = {
    'dashboard.php': 'Tableau de bord',
    'students.php': 'Adhérents',
    'student-details.php': 'Dossier adhérent',
    'edit-student.php': 'Modifier un adhérent',
    'trash.php': 'Corbeille',
    'export.php': 'Export',
    'kyc-list.php': 'Validation KYC',
    'kyc-detail.php': 'Dossier KYC',
    'users.php': 'Utilisateurs',
    'add-user.php': 'Ajouter un utilisateur',
    'edit-user.php': 'Modifier un utilisateur',
    'manage-slider.php': 'Carrousel',
    'manage-journal.php': 'Journal',
    'edit-journal.php': 'Journal',
    'journal-preview.php': 'Journal',
    'upgrade-levels.php': 'Mise à niveau',
    'communications.php': 'Communications',
    'settings.php': 'Paramètres',
    'profile.php': 'Mon profil'
} %}
<header class="staff-topbar">
    <button id="staff-menu-toggle" class="btn staff-icon-button" type="button" aria-controls="sidebar-wrapper" aria-expanded="false" aria-label="Ouvrir le menu">
        <i class="fas fa-bars" aria-hidden="true"></i>
    </button>
    {% set page_label = staff_page_labels[staff_route]|default('Espace administration') %}
    {% if staff_route == 'dashboard.php' %}
        <h1 class="staff-page-title">{{ page_label }}</h1>
    {% else %}
        <span class="staff-page-title">{{ page_label }}</span>
    {% endif %}
    <div class="staff-toolbar">
        <button class="btn staff-icon-button theme-switcher" type="button">
            <i class="fas fa-moon staff-theme-moon" aria-hidden="true"></i>
            <i class="fas fa-sun staff-theme-sun" aria-hidden="true"></i>
            <span class="theme-label visually-hidden">Mode sombre</span>
        </button>
        <a href="profile.php" class="staff-profile">{{ session.first_name|default('Mon') }} {{ session.last_name|default('profil') }}</a>
        <a href="logout.php" class="btn staff-icon-button" aria-label="Déconnexion" title="Déconnexion"><i class="fas fa-sign-out-alt" aria-hidden="true"></i></a>
    </div>
</header>
