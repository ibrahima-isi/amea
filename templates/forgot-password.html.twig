{% extends 'layouts/staff-auth.html.twig' %}

{% block title %}Mot de passe oublié — AEESGS{% endblock %}

{% block body %}
    <section class="card staff-auth-panel" aria-labelledby="forgot-password-heading">
        <h1 id="forgot-password-heading" class="staff-auth-title">Mot de passe oublié</h1>
        <p class="staff-auth-description">
            Saisissez votre adresse e-mail. Si un compte actif correspond, un lien de réinitialisation valable 5 minutes vous sera envoyé.
        </p>

        <form method="POST" action="forgot-password.php" class="staff-auth-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div>
                <label for="email" class="form-label">Adresse e-mail</label>
                <input type="email" id="email" name="email" class="form-control" autocomplete="email"
                       placeholder="votre@email.com" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary">Envoyer le lien</button>
        </form>

        <a href="login.php" class="staff-auth-return"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour à la connexion</a>
    </section>
{% endblock %}
