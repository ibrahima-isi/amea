{
    "require": {
        "phpmailer/phpmailer": "^6.9",
        "twig/twig": "^3.0",
        "doctrine/migrations": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Amea\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amea\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
