# LiteSpeed / Apache split document root rules for Namecheap Stellar.
# Only allowlisted static assets under /assets/ are served directly; every
# other request routes through index.php where the fixed app identity and
# canonical route allowlist enforce access.

Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve cPanel AutoSSL / Let's Encrypt HTTP-01 challenge path.
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # Deny all other hidden files and directories (e.g. .htaccess, .env, .git).
    RewriteRule (^|/)\. - [F,L]

    # Enforce HTTPS (Cloudflare or origin TLS).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Mark versioned static assets (?v=<mtime>) for immutable 1-year browser + Cloudflare caching.
    RewriteCond %{REQUEST_URI} ^/assets/.+\.(css|js|json|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf)$ [NC]
    RewriteCond %{QUERY_STRING} (^|&)v=[0-9A-Za-z._-]+(&|$)
    RewriteRule ^ - [E=AMEA_IMMUTABLE_ASSET:1]

    # Route everything except allowlisted static assets to the fixed front controller.
    RewriteCond %{REQUEST_URI} !^/assets/.+\.(css|js|json|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf)$ [NC]
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    # PHP selects and hashes the encoded representation for these HTML routes.
    SetEnvIf Request_URI "^/(index\.php|legal-notice\.php|journal\.php|journal-article\.php)?$" no-gzip=1
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_headers.c>
    Header unset Server
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 week"
    ExpiresByType application/javascript   "access plus 1 week"
    ExpiresByType text/javascript          "access plus 1 week"
    ExpiresByType application/json         "access plus 1 week"
    ExpiresByType image/jpeg               "access plus 1 week"
    ExpiresByType image/png                "access plus 1 week"
    ExpiresByType image/gif                "access plus 1 week"
    ExpiresByType image/webp               "access plus 1 week"
    ExpiresByType image/svg+xml            "access plus 1 week"
    ExpiresByType image/x-icon             "access plus 1 week"
    ExpiresByType font/woff2               "access plus 1 month"
    ExpiresByType font/woff                "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|json|jpg|jpeg|png|gif|webp|svg|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400" env=!AMEA_IMMUTABLE_ASSET
        Header set CDN-Cache-Control "public, max-age=2592000, stale-while-revalidate=86400" env=!AMEA_IMMUTABLE_ASSET
        Header set Cloudflare-CDN-Cache-Control "public, max-age=2592000, stale-while-revalidate=86400" env=!AMEA_IMMUTABLE_ASSET
        Header set Cache-Control "public, max-age=31536000, immutable" env=AMEA_IMMUTABLE_ASSET
        Header set CDN-Cache-Control "public, max-age=31536000, immutable" env=AMEA_IMMUTABLE_ASSET
        Header set Cloudflare-CDN-Cache-Control "public, max-age=31536000, immutable" env=AMEA_IMMUTABLE_ASSET
        Header append Vary "Accept-Encoding"
    </FilesMatch>
</IfModule>
