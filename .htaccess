# Disable directory listings
Options -Indexes

# Hide the server signature
ServerSignature Off

# Return a generic 404 for both 403 and 404 responses to avoid confirming file existence
ErrorDocument 403 /404-handler.php
ErrorDocument 404 /404-handler.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to version-control directories
    RewriteRule ^\.git(/.*)?$  - [F,L]
    RewriteRule ^\.svn(/.*)?$  - [F,L]
    RewriteRule ^svn(/.*)?$    - [F,L]

    # Return 404 for common attack paths before any redirect
    RewriteRule ^(admin|adm|administrator|wp-admin|wp-login\.php|phpmyadmin|pma|myadmin)(/.*)?$ /404-handler.php [L]
    RewriteRule ^(amanda|apache|bin|ftp|guest|http|log|shell|backup|cgi-bin|cgi|test|old|tmp|temp|web|www|cpanel|webmail|roundcube|plesk)(/.*)?$ /404-handler.php [L]

    # HTTPS is terminated by the trusted Traefik reverse proxy.
    # Traefik must overwrite X-Forwarded-Proto from untrusted clients.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Front Controller: Send all non-existent requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]

</IfModule>

# Block direct access to sensitive files
<FilesMatch "(^\.env|^\.htaccess|^\.htpasswd|^\.hta|composer\.(json|lock))$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Block access to sensitive file types
<FilesMatch "\.(sql|yml|yaml|md)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header unset Server
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 week"
    ExpiresByType application/javascript   "access plus 1 week"
    ExpiresByType application/x-javascript "access plus 1 week"
    ExpiresByType text/javascript          "access plus 1 week"
    ExpiresByType image/jpg                "access plus 1 week"
    ExpiresByType image/jpeg               "access plus 1 week"
    ExpiresByType image/gif                "access plus 1 week"
    ExpiresByType image/png                "access plus 1 week"
    ExpiresByType image/webp               "access plus 1 week"
    ExpiresByType image/svg+xml            "access plus 1 week"
    ExpiresByType image/x-icon             "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
</IfModule>
